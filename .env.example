# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Neon PostgreSQL - recommended)
# Get your connection string from https://console.neon.tech
DATABASE_URL=postgresql://username:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Alternative: individual connection settings (local PostgreSQL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ecommerce
# DB_USER=postgres
# DB_PASSWORD=your_password_here

# Set to false only for local PostgreSQL without SSL
# DB_SSL=false

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_random
JWT_EXPIRES_IN=7d
